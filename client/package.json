{
    "name": "mealplan-ui",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --host 0.0.0.0",
        "start:mock": "ng serve --host 0.0.0.0 --proxy-config proxy.mock.conf.json",
        "mock": "prism mock ../contracts/openapi.yaml",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:cov": "ng test --watch=false --coverage",
        "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
        "lint": "ng lint"
    },
    "private": true,
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
    "dependencies": {
        "@angular/cdk": "^22.2.4",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@ng-icons/core": "^36.1.0",
        "@ng-icons/lucide": "^36.1.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular-eslint/builder": "22.6.0",
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.4",
        "@angular/compiler-cli": "^22.2.3",
        "@eslint/js": "^10.0.1",
        "@mealplan/shared": "workspace:*",
        "@stoplight/prism-cli": "5.15.11",
        "@tailwindcss/postcss": "^4.3.3",
        "@vitest/coverage-v8": "5.0.5",
        "angular-eslint": "22.6.0",
        "autoprefixer": "^10.5.4",
        "axe-core": "^4.14.0",
        "daisyui": "^5.7.0",
        "eslint": "^10.9.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "jsdom": "^30.0.0",
        "postcss": "^8.5.22",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "8.72.0",
        "vitest": "^5.0.0"
    }
}
