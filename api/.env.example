# Copy to .env (never committed). Local development values only.

# Read by Docker Compose to create the database (docker-compose.yml)
POSTGRES_USER=mealplan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mealplan_monorepo

# Read by NestJS and Prisma: same values, port 5433 (docker-compose.yml)
DATABASE_URL=postgresql://mealplan:change-me@localhost:5433/mealplan_monorepo

# Required to start; any value works unless you import a recipe from a video (real key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=not-set
